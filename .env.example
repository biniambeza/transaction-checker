# Token from @BotFather
BOT_TOKEN=123456789:AA...

# Optional proxy for Telegram (e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:7890 if Telegram is restricted)
TELEGRAM_PROXY=

# Owner Telegram user ids (numbers, comma separated). Get yours from @userinfobot
OWNER_IDS=111111111

# Waiters register by sending /join <JOIN_CODE> to the bot
JOIN_CODE=shop2026

# ---- Where customers must send money (very important) ----
# All your receiving accounts, comma separated: full CBE / other bank account numbers and
# telebirr phone numbers. Used to:
#   * flag receipts where the money went to someone else's account
#   * check CBE receipts on CBE's website (needs your 13-digit CBE account number)
MY_ACCOUNTS=1000123456076,0911223344
# Account holder name(s) exactly as banks print them (used when the account number isn't shown)
MY_NAMES=Wegahta Yibrah Hailu

# Look up CBE and telebirr transactions on the bank's own website (1 = on, 0 = off)
BANK_CHECK=1
# Mark entries "verified" automatically when the bank confirms amount + receiver (1 = on, 0 = off)
AUTO_VERIFY=1
# Receipts older than this (hours) are flagged as possibly re-used screenshots
MAX_RECEIPT_AGE_HOURS=24
BANK_TIMEOUT=20

# ---- Dashboard ----
# Public HTTPS address of this server (needed for the dashboard inside Telegram).
# For testing: run `cloudflared tunnel --url http://localhost:8080` and paste the https URL here.
WEBAPP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ---- Time & money ----
TIMEZONE=Africa/Addis_Ababa
# Sales before this hour count for the previous day (e.g. 4 if you close at 2-3am)
DAY_START_HOUR=0
# When owners get the automatic end-of-day summary (HH:MM, local time)
DAILY_REPORT_TIME=23:00
CURRENCY=ETB
